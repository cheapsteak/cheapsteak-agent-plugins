{
  "description": "shell-guards — block Bash kill commands that hit unrelated processes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
